# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交。
# 以下默认值可直接用于评审环境（标准端口），无需修改。
#
# 注意：下面这些值只是"示例凭据"，不是任何真实环境的密码。
# ---------------------------------------------------------------------------

# --- 宿主机端口映射 ---
# 本机若 3306 / 8080 / 3000 已被占用，改成 3307 / 8092 / 3001 之类
MYSQL_PORT=3306
API_PORT=8080
WEB_PORT=3000

# --- MySQL ---
MYSQL_ROOT_PASSWORD=tujang_root_pw
MYSQL_DATABASE=tujang
MYSQL_USER=tujang
MYSQL_PASSWORD=tujang_pw

# --- 后端 ---
# dev：挂载 /api/dev/**（失败注入、耗时调节、切换用户）。
# prod：这些接口整体 404，用来验证"开发工具不会进生产"。
SPRING_PROFILES_ACTIVE=dev
# APP_TASK_POOL_SIZE=4
# APP_TASK_QUEUE_CAPACITY=50

# --- 前端（仅本地 pnpm dev / pnpm start 时读取）---
# 容器内的代理目标由 docker-compose.yml 的 build args 固定成 http://api:8080，
# 不要在这里改；这里只管"不进容器、直接跑 pnpm dev"的场景。
BACKEND_URL=http://localhost:8080
