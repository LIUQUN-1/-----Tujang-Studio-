# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交。
# 以下默认值可直接用于评审环境（标准端口），无需修改。
# ---------------------------------------------------------------------------

# --- 宿主机端口映射 ---
# 本机若 3306 / 8080 已被占用，改成 3307 / 8082
MYSQL_PORT=3306
API_PORT=8080
WEB_PORT=3000

# --- MySQL ---
MYSQL_ROOT_PASSWORD=tujang_root_pw
MYSQL_DATABASE=tujang
MYSQL_USER=tujang
MYSQL_PASSWORD=tujang_pw

# --- 后端 ---
SPRING_PROFILES_ACTIVE=dev

# --- 前端（服务端使用，转发目标；浏览器不感知）---
# compose 内为 http://api:8080；本机直接 pnpm dev 时为 http://localhost:8082
BACKEND_URL=http://localhost:8082
